{
  "name": "financial-analysis-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "Web UI for the Financial_Analysis quant framework (Vue 3 + Vite). Talks to the FastAPI backend at /api/v1.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "start": "node server.js",
    "preview": "npm run build && node server.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "dompurify": "3.4.16",
    "echarts": "5.6.0",
    "element-plus": "2.14.7",
    "highlight.js": "11.12.0",
    "marked": "18.1.0",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
