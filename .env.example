# Copy to .env and fill in. .env is git-ignored.

# Tushare Pro token (last source in the fallback chain; skipped when empty)
TUSHARE_TOKEN=

# Fallback order for daily bars
DAILY_SOURCE_ORDER=tencent,mootdx,eastmoney,baostock,akshare,tushare
# Adjustment-factor sources (mootdx = computed from TDX corporate actions)
FACTOR_SOURCE_ORDER=mootdx,baostock,tushare

# Optional: TDX servers to try first, ip:port,ip:port
TDX_SERVERS=

# Storage location (default: data/lake)
# QUANT_LAKE_DIR=
DATA_WORKERS=8
DUCKDB_MEMORY_LIMIT=1GB

# Backend
API_HOST=127.0.0.1
API_PORT=8000
# If set, POST /api/v1/data/update requires header X-Admin-Token.
# If empty, write endpoints only accept requests from localhost.
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
